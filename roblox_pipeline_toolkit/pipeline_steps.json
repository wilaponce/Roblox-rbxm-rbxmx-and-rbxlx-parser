{
  "main_steps": [
    {
      "id": "download_place",
      "label": "Download Place (.rbxlx/.rbxl)",
      "script": "download_place_rbxl.js",
      "mode": "prompt_asset_id",
      "prompt": "Enter Place Asset ID to download: ",
      "backup": false,
      "in_full_pipeline": false
    },
    {
      "id": "download_rbxm",
      "label": "Download Model (.rbxm/.rbxmx)",
      "script": "download_model_rbxm.js",
      "mode": "prompt_asset_id",
      "prompt": "Enter Model Asset ID to download: ",
      "backup": false,
      "in_full_pipeline": false
    },
    {
      "id": "convert_rbxm",
      "label": "Convert Binary .rbxm to .rbxmx",
      "script": "convert_rbxm_to_rbxmx.py",
      "mode": "single",
      "exts": ["rbxm"],
      "backup": false,
      "in_full_pipeline": false
    },
    {
      "id": "submenu_xml_repairs",
      "label": "XML Structure & Tag Repairs [Submenu ->]",
      "mode": "submenu",
      "submenu_key": "xml_repairs"
    },
    {
      "id": "install_model",
      "label": "Install .rbxmx Model into Place",
      "script": "install_martial_combat.py",
      "mode": "merge_to_output",
      "exts": ["rbxlx"],
      "exts2": ["rbxmx"],
      "default_out": "merged_place.rbxlx",
      "backup": false,
      "in_full_pipeline": false
    },
    {
      "id": "check_schema",
      "label": "Quick Grouped Schema Check",
      "script": "check_rbxlx.py",
      "mode": "single",
      "exts": ["rbxlx"],
      "backup": false,
      "in_full_pipeline": false
    },
    {
      "id": "verify_opencloud",
      "label": "Verify Open Cloud Upload Readiness",
      "script": "verify_opencloud_place.py",
      "mode": "single",
      "exts": ["rbxlx", "rbxl"],
      "backup": false,
      "in_full_pipeline": true
    },
    {
      "id": "diff_files",
      "label": "Compare Two RBXLX Files",
      "script": "diff_rbxlx.py",
      "mode": "pair",
      "exts": ["rbxlx"],
      "exts2": ["rbxlx"],
      "backup": false,
      "in_full_pipeline": false
    },
    {
      "id": "publish_place",
      "label": "Publish Place to Open Cloud",
      "script": "BUILTIN_PUBLISH",
      "mode": "single",
      "exts": ["rbxlx", "rbxl"],
      "backup": false,
      "in_full_pipeline": false
    },
    {
      "id": "submenu_additional",
      "label": "Additional Repairs & Lua Audits [Submenu ->]",
      "mode": "submenu",
      "submenu_key": "additional_repairs"
    }
